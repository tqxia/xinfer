{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xinfer decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "created_at",
    "revision",
    "evidence",
    "outcome",
    "readiness",
    "acceptance",
    "assessment",
    "next_action"
  ],
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outcome": {
      "enum": [
        "keep",
        "revise",
        "reject",
        "defer"
      ]
    },
    "readiness": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local",
        "model"
      ],
      "properties": {
        "local": {
          "enum": [
            "passed",
            "failed",
            "unverified"
          ]
        },
        "model": {
          "enum": [
            "passed",
            "failed",
            "unverified"
          ]
        }
      }
    },
    "assessment": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "next_baseline": {
      "type": "string",
      "minLength": 1
    }
  }
}
