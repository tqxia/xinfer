{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xinfer revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "created_at",
    "candidate",
    "parents",
    "change",
    "source"
  ],
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidate": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "parents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change": {
      "type": "string",
      "minLength": 1
    },
    "prediction": {
      "type": "string",
      "minLength": 1
    },
    "motivation": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "follows_decision": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "artifacts"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    }
  }
}
