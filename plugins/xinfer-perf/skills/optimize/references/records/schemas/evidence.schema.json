{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xinfer evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "created_at",
    "kind",
    "scope",
    "subjects",
    "status",
    "artifacts"
  ],
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "kernel",
        "model"
      ]
    },
    "subjects": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "export": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "workload": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "not_run"
      ]
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "status": {
        "enum": [
          "failed",
          "not_run"
        ]
      }
    }
  },
  "then": {
    "required": [
      "summary"
    ]
  }
}
