{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xinfer candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "created_at",
    "baseline_revision",
    "origin",
    "initial_readiness",
    "hypothesis",
    "prediction",
    "motivation"
  ],
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline_revision": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "initial_readiness": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "prediction": {
      "type": "string",
      "minLength": 1
    },
    "motivation": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "follows_decision": {
      "type": "string",
      "minLength": 1
    }
  }
}
