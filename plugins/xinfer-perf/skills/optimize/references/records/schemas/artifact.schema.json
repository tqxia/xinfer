{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xinfer artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "uri"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pointer": {
      "type": "string",
      "pattern": "^(|/.*)$"
    }
  }
}
